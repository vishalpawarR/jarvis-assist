{
  "manifest_version": 3,
  "name": "Jarvis Job Assistant",
  "version": "0.2.0",
  "description": "A private, local-first job search helper with a floating website panel.",
  "permissions": ["storage", "activeTab", "tabs", "downloads", "clipboardWrite", "alarms", "notifications"],
  "icons": {
    "128": "icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Jarvis",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-jarvis-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open or close the floating Jarvis panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
